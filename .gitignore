# ESP-IDF build output
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock

# The Bosch LDI specification is not ours to redistribute. See docs/README.md.
docs/*.pdf

# Machine-specific editor state. The committed .vscode files are portable;
# local overrides (IDF paths, serial port) belong outside version control.
.vscode/settings.local.json
.vscode/launch.json

# Python
__pycache__/
*.pyc

# Editor / OS
.cache/
compile_commands.json
*.swp
Thumbs.db

# Capture dumps read off the board. Large, machine-specific, not history.
captures/

# Recorded activities. Ride data from the watch and the Flow app: useful for
# diagnosing a session, personal, and not something to publish with the code.
*.fit
*.FIT

# Android bug reports, pulled to read the phone's Bluetooth HCI log.
bugreport*.zip